# ============================================================
# EMS – Environment Configuration
# Copy to .env and fill in your values.
# This file is NOT loaded automatically — set these as real
# environment variables (via Apache SetEnv, Nginx fastcgi_param,
# or a shell export before the PHP process starts).
# ============================================================

APP_ENV=production        # development | production

DB_HOST=localhost
DB_NAME=ems_db
DB_USER=ems_user
DB_PASS=your_strong_password_here
x